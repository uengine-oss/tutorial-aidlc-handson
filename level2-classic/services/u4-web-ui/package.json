{
  "name": "u4-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VoiceParking 화면 (Vue 3 + Vite 개발 서버 프록시). 개발 서버 전용이며 배포하지 않는다.",
  "scripts": {
    "dev": "vite",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "lint": "eslint . && prettier --check .",
    "build": "vite build",
    "audit:report": "node scripts/audit-report.mjs",
    "verify": "npm run lint && npm run test && npm run test:coverage && npm run build && npm run audit:report"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
